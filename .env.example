# SriVoraTech Database Environment Configuration

# 1. Google Sheets Integration
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# 2. Firebase Realtime Database / Firestore Integration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=srivoratech-ratings.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://srivoratech-ratings-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=srivoratech-ratings
VITE_FIREBASE_STORAGE_BUCKET=srivoratech-ratings.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# 3. MongoDB Atlas Database (Authoritative Primary Storage)
# Required for production contact form persistence with majority write concern
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=srivoratech

# 4. Redis Distributed Rate Limiting (Required in Production)
# Vercel KV / Upstash Redis / Managed Redis
REDIS_URL=rediss://default:<password>@<host>:<port>

# 5. IP Pseudonymization Security Secret
# Cryptographically strong salt (minimum 32 characters, e.g. generated via openssl rand -hex 32)
# Production will reject startup if this is missing or using default/test values
IP_HASH_SALT=your_minimum_32_character_cryptographic_secret_here

# 6. Supabase Cloud Database Integration (Optional)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
